---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Palvelut">
  <h1>Palvelut</h1>
  <p>Tarjoan automaatio-, raportointi- ja verkkosivuratkaisuja pienyrityksille. Suunnittelen ja toteutan käytännön työkaluja, jotka toimivat arjessa ja helpottavat työtäsi.</p>

  <h2>Mitä teen</h2>
  <ul>
    <li><strong>Verkkosivujen tarkistus</strong> - analysoin yrityksesi verkkosivut ja löydän ongelmat. Saat selkeän raportin suomeksi.</li>
    <li><strong>Automaatioratkaisut</strong> - automatisoin toistuvia työvaiheita. Vähemmän manuaalista työtä, enemmän aikaa asiakkaillesi.</li>
    <li><strong>AI-työkalut</strong> - rakennan tekoälyavusteisia työkaluja, jotka helpottavat jokapäiväistä työtä.</li>
  </ul>

  <h2>Ota yhteyttä</h2>
  <ul>
    <li>Sähköposti: <span class="text-muted">coming soon</span></li>
    <li>GitHub: <a href="https://github.com/jimiprusti" target="_blank" rel="noopener">github.com/jimiprusti</a></li>
  </ul>

  <p class="text-sm text-muted in-english">
    <a href={base}>In English -></a>
  </p>
</BaseLayout>

<style>
  .in-english {
    margin-top: 2rem;
  }
</style>
