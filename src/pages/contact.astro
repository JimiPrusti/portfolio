---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Contact">
  <h1>Contact</h1>
  <p>Want to connect? Reach out through any of the channels below.</p>

  <ul>
    <li>Email: <span class="text-muted">coming soon</span></li>
    <li>GitHub: <a href="https://github.com/jimiprusti" target="_blank" rel="noopener">github.com/jimiprusti</a></li>
    <li>LinkedIn: <span class="text-muted">coming soon</span></li>
  </ul>

  <p class="text-sm text-muted finnish-note">
    <a href={`${base}palvelut/`}>Tarjoan palveluita myös suomeksi.</a>
  </p>
</BaseLayout>

<style>
  .finnish-note {
    margin-top: 2rem;
  }
</style>
